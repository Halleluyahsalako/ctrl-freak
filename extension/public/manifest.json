{
  "manifest_version": 3,
  "name": "Ctrl+Freak",
  "version": "0.1.0",
  "description": "Clipboard, note, and file sync with your phone — no WhatsApp required.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "hal-popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "hal-background.js",
    "type": "module"
  },
  "permissions": ["storage", "identity", "clipboardRead", "clipboardWrite"],
  "host_permissions": [
    "https://*.googleapis.com/*",
    "https://*.firebaseio.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Ctrl+Freak"
    }
  }
}
