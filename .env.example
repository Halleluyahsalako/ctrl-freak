# Copy this file to .env and fill in values from your own Firebase project.
# See docs/SETUP.md for how to get each of these.
# Never commit the real .env — it's already in .gitignore.

# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Google OAuth client for Drive access (Google Cloud console > APIs & Services > Credentials)
# Scope requested: https://www.googleapis.com/auth/drive.file
# (drive.file only — the app can only see files it creates itself, never your whole Drive)
GOOGLE_OAUTH_CLIENT_ID=
